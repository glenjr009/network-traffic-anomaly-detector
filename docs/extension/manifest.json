{
  "manifest_version": 3,
  "name": "Network Anomaly Detector",
  "version": "1.0.0",
  "description": "Browser security extension for the Network Traffic Anomaly Detection.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Network Anomaly Detector"
  },
  "background": {
    "service_worker": "background/background.js"
  }
}   