# ==============================================================================
# NetGuard AI - Environment Configuration Template
# Copy this file to '.env' and populate your own API keys.
# DO NOT commit '.env' containing private keys to version control.
# ==============================================================================

# LLM Provider Selection
# Options: 'auto', 'gemini', 'openai', 'groq', 'ollama', 'offline_soc'
# Default: 'auto' (checks Gemini -> Groq -> OpenAI -> Ollama -> Offline Fallback)
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# Google Gemini Settings (Recommended for high speed & free tier quota)
# Get a key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Groq Settings (Fast free-tier inference)
# Get a key at: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# OpenAI Settings
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Ollama Settings (Local open-source LLM, no API key needed)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# RAG & Generation Parameters
# ------------------------------------------------------------------------------
# Embeddings: 'tfidf' (offline default), 'sentence_transformers', 'gemini', 'openai'
RAG_EMBEDDING_PROVIDER=tfidf
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.26
RAG_MAX_CONTEXT_LENGTH=3000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Live Network Capture Settings (Optional)
# ------------------------------------------------------------------------------
NAD_ENABLE_CAPTURE=0
NAD_INTERFACE_INDEX=18

# ------------------------------------------------------------------------------
# CORS (comma-separated). Do NOT use '*' when credentials are enabled.
# Chrome extension origins are also allowed via chrome-extension:// regex.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:8501
